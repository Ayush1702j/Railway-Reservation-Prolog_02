booked(PassengerName, TrainName) :-
    passenger(PID, PassengerName),
    reservation(PID, TrainID),
    train(TrainID, TrainName, _, _).

route(TrainName, Source, Destination) :-
    train(_, TrainName, Source, Destination).

has_reservation(PassengerName) :-
    passenger(PID, PassengerName),
    reservation(PID, _).

ticket_fare(PassengerName, Fare) :-
    passenger(PID, PassengerName),
    reservation(PID, TrainID),
    fare(TrainID, Fare).

available_train(Source, TrainName) :-
    train(_, TrainName, Source, _).

arriving_train(Destination, TrainName) :-
    train(_, TrainName, _, Destination).

passenger_train(PassengerName, TrainName) :-
    booked(PassengerName, TrainName).

unreserved(PassengerName) :-
    passenger(_, PassengerName),
    \+ has_reservation(PassengerName).
